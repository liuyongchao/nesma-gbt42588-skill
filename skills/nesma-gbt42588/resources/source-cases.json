  "cases": [
    {
      "id": "c01",
      "title": "表2：初始版本及两次增强的项目规模与应用规模",
      "type": "case",
      "example_kind": "worked_example",
      "source_class": "normative_context_example",
      "source_chapter": "5.6.1 表2；参照5.5.3、5.6.4",
      "source_pages": [
        18
      ],
      "chunk_id": null,
      "source_quote": "表2举例说明了如何确定项目和应用程序的功能规模以及两者之间的差异。",
      "summary": "输入：初始新增1000；版本1新增200、删除40、修改前80/后100；版本2新增500、删除100、修改前220/后200。各列按相应版本计算，修改前后值不能混用。",
      "bound_to": [
        "项目规模与应用程序规模",
        "增强前后基线"
      ],
      "outcome": "初始项目/应用均1000 FP；版本1项目200+100+40=340 FP，应用1000+200+100−80−40=1180 FP；版本2项目500+200+100=800 FP，应用1180+500+200−220−100=1560 FP。",
      "tags": [
        "case",
        "worked_example",
        "enhancement",
        "recalculable"
      ],
      "task_ids": [
        "T11"
      ],
      "verification": "所列页面原图已核验",
      "inputs": {
        "initial": 1000,
        "v1": {
          "ADD": 200,
          "DEL": 40,
          "CHGB": 80,
          "CHGA": 100
        },
        "v2": {
          "ADD": 500,
          "DEL": 100,
          "CHGB": 220,
          "CHGA": 200
        }
      },
      "source_note": "原表版本1修改前为80；OCR遗漏该格。表中无转换软件数值。"
    },
    {
      "id": "c02",
      "title": "并行子项目与可独立运行子系统的数据交换",
      "type": "case",
      "example_kind": "worked_example",
      "source_class": "normative_context_example",
      "source_chapter": "5.6.2.2 b)",
      "source_pages": [
        19
      ],
      "chunk_id": null,
      "source_quote": "如果子系统必须能够独立存在（例如，由于应用程序的分阶段实施或出于功能原因），那么子系统之间的数据交换也包含在每个子项目的功能规模中。",
      "summary": "原文设一个应用被多个并行子项目分担，每个实现一个可独立存在的子系统。子系统接口属于各子项目范围，在应用整体边界内则不再跨越该边界。",
      "bound_to": [
        "边界决定计数",
        "子项目汇总"
      ],
      "outcome": "项目各子项目规模之和可以高于应用规模；没有给出数量和FP。",
      "tags": [
        "case",
        "worked_example",
        "boundary",
        "subproject"
      ],
      "task_ids": [
        "T01",
        "T11"
      ],
      "verification": "所列页面原图已核验"
    },
